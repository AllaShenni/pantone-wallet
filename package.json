{
  "name": "pantone-wallet",
  "version": "1.0.0",
  "description": "Premium Pantone Currency Converter",
  "main": "main.js",
  "author": "AllaShenni",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . PantoneWallet --platform=win32 --arch=x64 --icon=icons/wallet.ico --out=dist --overwrite --app-version=1.0.0 --win32metadata.ProductName=\"Pantone Wallet\" --win32metadata.CompanyName=\"AllaShenni\" --win32metadata.FileDescription=\"Premium Currency Converter\" --ignore=\"^/(VideoCard-AI|flight_parser_bot|photo_consultation_bot|video_script_editor|docs|dist|\\.vscode)(/|$)\" --ignore=\"(^|/)\\.env\" --ignore=\"\\.(session|db)$\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1"
  },
  "allowScripts": {
    "electron@45.2.1": true
  }
}
